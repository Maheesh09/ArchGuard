# Copy to .env and change the passwords. Both docker compose and the Spring
# Boot app read this file, so the containers and the app always agree.
# Every value is optional: the defaults match docker-compose.yml.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=archguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
